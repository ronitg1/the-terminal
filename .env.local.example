# =============================================================================
# The Terminal — environment variables
# Copy this file to `.env.local` and fill in the values.
# Vars marked REQUIRED must be set or the app won't boot / sign in.
# Everything else is feature-gated — those features no-op gracefully when missing.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase  [REQUIRED]
# Create a free project at supabase.com → Project Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role JWT (NOT the anon key). Bypasses RLS for cron paths. Without this
# the cron-fan-out for thesis runs and the weekly email won't be able to read
# other users' rows.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# App  [REQUIRED]
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# LLM provider  [REQUIRED — at least one]
# "deepseek" (default, ~14× cheaper) or "anthropic".
# -----------------------------------------------------------------------------
LLM_PROVIDER=deepseek

# DeepSeek — required when LLM_PROVIDER=deepseek. Sign up: platform.deepseek.com
DEEPSEEK_API_KEY=

# Anthropic — required when LLM_PROVIDER=anthropic OR for fallback only.
# Sign up: console.anthropic.com
ANTHROPIC_API_KEY=

# Tavily web search — used by the DeepSeek chat tool path (DeepSeek has no
# built-in web search) and the article-summarizer. Free tier: 1000/mo.
# Sign up: tavily.com
TAVILY_API_KEY=

# Hard cap on LLM spend per calendar month (USD). Default: 5.
# Set a matching limit in your provider console for a true hard stop.
ANTHROPIC_MONTHLY_BUDGET_USD=5

# -----------------------------------------------------------------------------
# News  [STRONGLY RECOMMENDED]
# -----------------------------------------------------------------------------
# Finnhub — preferred per-ticker news source. Free tier: 60 req/min.
# Sign up: finnhub.io
FINNHUB_API_KEY=
# NewsAPI — fallback per-ticker + always-on for macro/sector search.
# Free tier is localhost-only (won't work in production).
# Sign up: newsapi.org
NEWS_API_KEY=

# -----------------------------------------------------------------------------
# Email — weekly Sunday recap  [OPTIONAL]
# Resend: resend.com → Settings → API Keys
# Without these, the Weekly email button + Sunday cron just no-op.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Either Resend's sandbox sender (only delivers to YOUR Resend-account email)
# or an address on a domain you've verified in Resend.
# Format: "Display Name <address@domain.com>"
RESEND_FROM_EMAIL=The Terminal <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# Push notifications  [OPTIONAL]
# Without these, the Push Notifications setting just shows "not configured".
# Generate keypair:  npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# -----------------------------------------------------------------------------
# Cron auth  [REQUIRED for Vercel deployments]
# Vercel Cron routes are authenticated by Authorization: Bearer $CRON_SECRET.
# Generate any 32+ char hex string. PowerShell:
#   [Convert]::ToHexString((New-Object byte[] 32 | %{[System.Security.Cryptography.RandomNumberGenerator]::Fill($_); $_}))
# Or openssl: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=
