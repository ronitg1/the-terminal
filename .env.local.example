# Supabase — required for Phase 1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LLM provider — "deepseek" (default, cheaper) or "anthropic" (fallback).
LLM_PROVIDER=deepseek

# DeepSeek API — required when LLM_PROVIDER=deepseek (the default).
# Sign up at platform.deepseek.com.
DEEPSEEK_API_KEY=

# Tavily web search — used by the DeepSeek chat path for live lookups.
# Free tier is 1000 searches/month. Sign up at tavily.com.
TAVILY_API_KEY=

# Anthropic — only needed if you flip LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# News + email
NEWS_API_KEY=
RESEND_API_KEY=

# Required for Vercel cron auth. Generate with: openssl rand -hex 32
CRON_SECRET=

# Hard cap on LLM spend per calendar month (USD). Default: 5.
# ALSO set a matching spend limit in your provider console (DeepSeek or Anthropic).
ANTHROPIC_MONTHLY_BUDGET_USD=5
